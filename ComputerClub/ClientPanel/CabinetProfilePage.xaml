<Page x:Class="ComputerClub.ClientPanel.CabinetProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">
    <Grid Background="#0F0F1A" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="Мой профиль"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource AccentYellow}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Основная информация о клиенте -->
        <Border Grid.Row="1" Background="#121212" CornerRadius="12" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="ФИО:" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               Width="140"/>
                    <TextBlock x:Name="tbFullName" 
                               FontSize="16" 
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Телефон:" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               Width="140"/>
                    <TextBlock x:Name="tbPhone" 
                               FontSize="16" 
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Пол:" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               Width="140"/>
                    <TextBlock x:Name="tbGender" 
                               FontSize="16" 
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Email:" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               Width="140"/>
                    <TextBlock x:Name="tbEmail" 
                               FontSize="16" 
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дата регистрации:" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               Width="140"/>
                    <TextBlock x:Name="tbRegistrationDate" 
                               FontSize="16" 
                               Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Редактировать профиль"
                    Style="{StaticResource YellowActionButton}"
                    Width="220" Height="48"
                    Click="EditProfile_Click"/>
        </StackPanel>
    </Grid>
</Page>