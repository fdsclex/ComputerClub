<Page x:Class="ComputerClub.ClientPanel.ClientCabinetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Grid Background="#0F0F1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="#1A1A2E" Grid.Row="0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbWelcome"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Баланс:" FontSize="16" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="tbBalance"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentYellow}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="tbStatus"
                                   FontSize="16" Foreground="#AAAAAA"
                                   Margin="24,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnChatTab" Content="Чат с админом"
                            Style="{StaticResource YellowActionButton}"
                            Width="180" Height="48" Margin="0,0,12,0"
                            Click="SwitchChatTariff_Click" Tag="Chat"/>
                    <Button x:Name="btnTariffTab" Content="Тарифы"
                            Style="{StaticResource YellowActionButton}"
                            Width="180" Height="48"
                            Click="SwitchChatTariff_Click" Tag="Tariff"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
                <!-- чат/тарифы -->
            </Grid.ColumnDefinitions>

            <!-- Левое меню -->
            <Border Background="#1A1A2E" CornerRadius="0,12,12,0" Margin="0,0,16,0">
                <StackPanel Margin="16">
                    <RadioButton x:Name="rbShop" Content="Магазин" 
                                 Style="{StaticResource NavRadioButton}" 
                                 IsChecked="True" 
                                 Click="Tab_Click" Tag="Shop"/>
                    <RadioButton x:Name="rbNotifications" Content="Уведомления" 
                                 Style="{StaticResource NavRadioButton}" 
                                 Click="Tab_Click" Tag="Notifications"/>
                    <RadioButton x:Name="rbLoyalty" Content="Программа лояльности" 
                                 Style="{StaticResource NavRadioButton}" 
                                 Click="Tab_Click" Tag="Loyalty"/>
                    <RadioButton x:Name="rbProfile" Content="Профиль" 
                                 Style="{StaticResource NavRadioButton}" 
                                 Click="Tab_Click" Tag="Profile"/>
                </StackPanel>
            </Border>

            <!-- Центр: вкладка -->
            <Frame x:Name="CabinetFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
                   Background="Transparent"/>

            <!-- Правая панель: Чат / Тарифы -->
            <Grid Grid.Column="2" Margin="16,0,0,0">
                <!-- Чат (по умолчанию открыт, высота уменьшена) -->
                <Border x:Name="ChatPanel" Background="#1A1A2E" CornerRadius="12" Visibility="Visible">
                    <StackPanel Margin="16">
                        <TextBlock Text="Чат с администратором" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Border Background="#0F0F1A" CornerRadius="8" Height="400">
                            <!-- ← здесь уменьшено с 500 до 400 -->
                            <TextBlock Text="Здесь будут сообщения от админа и клиента"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" Margin="16"/>
                        </Border>
                        <TextBox Style="{StaticResource DarkInput}" Height="80" Margin="0,12,0,0" AcceptsReturn="True"/>
                        <Button Content="Отправить" Style="{StaticResource YellowActionButton}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Тарифы (скрыто) -->
                <Border x:Name="TariffPanel" Background="#1A1A2E" CornerRadius="12" Visibility="Collapsed">
                    <StackPanel Margin="16">
                        <TextBlock Text="Ваши тарифы" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                        <Border Background="#0F0F1A" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Текущий тариф: Стандарт" FontSize="16" Foreground="{StaticResource AccentYellow}"/>
                                <TextBlock Text="Скорость: 1 Гбит/с" FontSize="14" Foreground="#AAAAAA" Margin="0,8,0,0"/>
                                <TextBlock Text="Цена: 100 ₽/час" FontSize="14" Foreground="#AAAAAA"/>
                                <Button Content="Сменить тариф" Style="{StaticResource YellowActionButton}" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Нижняя панель -->
        <Border Background="#1A1A2E" Grid.Row="2">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Вернуться к столу" Style="{StaticResource YellowActionButton}" Width="220" Height="80" Margin="12" Click="BackToShell_Click"/>
                <Button Content="Выбрать игру" Style="{StaticResource YellowActionButton}" Width="220" Height="80" Margin="12"/>
                <Button Content="Сообщить о проблеме" Style="{StaticResource YellowActionButton}" Width="220" Height="80" Margin="12"/>
                <Button Content="Перенести за другой ПК" Style="{StaticResource YellowActionButton}" Width="220" Height="80" Margin="12"/>
                <Button Content="Начать сессию" Style="{StaticResource YellowActionButton}" Width="220" Height="80" Margin="12"/>
                <Button Content="Выйти из аккаунта" Style="{StaticResource FinishSessionButton}" Width="220" Height="80" Margin="12" Click="Logout_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Page>