<Page x:Class="ComputerClub.Navigation.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Бронирование места">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Бронирование компьютера / консоли"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource AccentYellow}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Выберите свободное устройство и время брони"
                       FontSize="16" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Список устройств -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icDevices">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A2E"
                                CornerRadius="12"
                                Margin="0,0,0,16"
                                Padding="20"
                                BorderBrush="#333344"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="White"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Type}"
                                                   FontSize="14" Foreground="#AAAAAA"/>
                                        <TextBlock Text=" • "
                                                   FontSize="14" Foreground="#AAAAAA"
                                                   Margin="8,0"/>
                                        <TextBlock Text="{Binding Specs}"
                                                   FontSize="14" Foreground="#AAAAAA"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TariffText}"
                                               FontSize="15" FontWeight="Medium"
                                               Foreground="{StaticResource AccentYellow}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="13" Foreground="#FF6B6B"
                                               Margin="0,6,0,0"
                                               />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Забронировать"
                                        Width="160" Height="50"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource YellowActionButton}"
                                        Tag="{Binding DeviceID}"
                                        Click="BookDevice_Click"
                                        IsEnabled="{Binding IsAvailable}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Обновить список"
                    Width="180" Height="50"
                    Click="Refresh_Click"
                    Style="{StaticResource YellowActionButton}"/>
        </StackPanel>

        <!-- Если список пуст -->
        <TextBlock x:Name="tbNoDevices"
                   Grid.Row="1"
                   Text="В данный момент нет свободных устройств"
                   FontSize="18" Foreground="#AAAAAA"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>