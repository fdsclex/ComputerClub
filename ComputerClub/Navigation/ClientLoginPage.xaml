<Page x:Class="ComputerClub.Navigation.ClientLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ComputerClub">
    <Grid Margin="40">
        <!-- Обычная форма входа -->
        <StackPanel x:Name="loginPanel"
                    Width="360"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Номер телефона" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="tbPhone"
                     Text="+7"
                     MaxLength="18"
                     PreviewTextInput="Phone_PreviewTextInput"
                     TextChanged="Phone_TextChanged"/>
            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <PasswordBox x:Name="pbPassword"
                             Style="{StaticResource DarkInput}"
                             Padding="12,10,48,10"
                             Visibility="Visible"/>
                <TextBox x:Name="tbPasswordVisible"
                         Style="{StaticResource DarkInput}"
                         Padding="12,10,48,10"
                         Visibility="Collapsed"
                         IsReadOnly="False"/>
                <Button x:Name="btnTogglePassword"
                        Style="{StaticResource PasswordToggleButton}"
                        Click="TogglePassword_Click"/>
            </Grid>
            <Button Content="ВОЙТИ"
                    Style="{StaticResource YellowActionButton}"
                    Margin="0,24,0,0"
                    Click="LoginButton_Click"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <TextBlock Text="Забыли пароль?"
                           Style="{StaticResource LinkStyle}"
                           MouseLeftButtonDown="ForgotPassword_Click"/>
                <TextBlock Text=" • " Foreground="#555"/>
                <TextBlock Text="Регистрация"
                           Style="{StaticResource LinkStyle}"
                           MouseLeftButtonDown="Register_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Панель восстановления пароля (одна рамка на весь процесс) -->
        <Border x:Name="resetPanel"
                Visibility="Collapsed"
                Background="#1E1E1E"
                BorderBrush="#FFD700"
                BorderThickness="2"
                CornerRadius="12"
                Padding="32"
                Margin="0,20,0,0"
                Width="550"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Восстановление пароля"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Блок ввода телефона (показывается первым) -->
                <StackPanel x:Name="phoneInputBlock">
                    <TextBlock Text="Введите номер телефона"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"/>
                    <TextBox x:Name="tbResetPhone"
                             Text="+7"
                             MaxLength="18"
                             Width="280"
                             PreviewTextInput="Phone_PreviewTextInput"
                             TextChanged="Phone_TextChanged"
                             Style="{StaticResource DarkInput}"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,0">
                        <Button Content="Отмена"
                                Width="140"
                                Height="52"
                                Margin="0,0,20,0"
                                Click="CancelReset_Click"
                                Style="{StaticResource YellowActionButton}"/>
                        <Button Content="Получить код"
                                Width="220"
                                Height="52"
                                Click="SendResetCode_Click"
                                Style="{StaticResource YellowActionButton}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Блок ввода кода + нового пароля (появляется после отправки кода) -->
                <StackPanel x:Name="codeAndPasswordBlock"
                            Visibility="Collapsed">
                    <TextBlock Text="Код из SMS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"/>
                    <TextBox x:Name="tbResetCode"
                             MaxLength="6"
                             Width="180"
                             HorizontalContentAlignment="Center"
                             FontSize="20"
                             Style="{StaticResource DarkInput}"/>

                    <TextBlock Text="Новый пароль"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,28,0,12"
                               HorizontalAlignment="Center"/>
                    <PasswordBox x:Name="pbNewPassword"
                                 Width="280"
                                 Style="{StaticResource DarkInput}"
                                 Padding="12,10"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,32,0,0">
                        <Button Content="Отмена"
                                Width="140"
                                Height="52"
                                Margin="0,0,20,0"
                                Click="CancelReset_Click"
                                Style="{StaticResource YellowActionButton}"/>
                        <Button Content="Сменить пароль"
                                Width="220"
                                Height="52"
                                Click="ChangePassword_Click"
                                Style="{StaticResource YellowActionButton}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Таймер -->
                <TextBlock x:Name="tbResetTimer"
                           Text=""
                           Foreground="#AAAAAA"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </Border>

        <!-- Блок капчи (без изменений) -->
        <Border x:Name="captchaPanel"
                Visibility="Collapsed"
                Background="#1E1E1E"
                BorderBrush="#444444"
                BorderThickness="2"
                CornerRadius="8"
                Margin="0,40,0,0"
                Padding="20"
                Width="500"
                Height="400">
            <StackPanel>
                <TextBlock Text="Введите символы ниже"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>
                <Border Background="#2A2A2A"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">
                    <Canvas x:Name="captchaCanvas"
                            Width="300"
                            Height="100"
                            ClipToBounds="True"/>
                </Border>
                <TextBox x:Name="tbCaptchaInput"
                         Margin="0,15,0,0"
                         Padding="10"
                         FontSize="15"
                         MaxLength="7"
                         KeyDown="TbCaptchaInput_KeyDown"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0">
                    <Button Content="Подтвердить"
                            Width="140"
                            Margin="0,0,20,0"
                            Click="ConfirmCaptcha_Click"
                            Style="{StaticResource YellowActionButton}"/>
                    <Button Content="Обновить"
                            Width="100"
                            Click="RefreshCaptcha_Click"
                            Style="{StaticResource YellowActionButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>